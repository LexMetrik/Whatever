{
  "git": { "deploymentEnabled": false },
  "buildCommand": "npm run build",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/international", "destination": "/gesetze?ebene=international", "permanent": true },
    { "source": "/gesetze/kanton/GL-III%2520B_7_1", "destination": "/gesetze/kanton/GL-III%2520B%252F7%252F1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!(?:normtext|rechtsprechung|materialien|such-index|assets)/.*\\.[a-zA-Z0-9]+).*)", "destination": "/app" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-PHDKaUhtsQAL5++AtD/vciemgsR4Pkpjwdi5eEm8CJU='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://www.zefix.ch https://api3.geo.admin.ch https://entscheidsuche.ch; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/normtext/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; frame-ancestors 'self'; object-src 'self'" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/rechtsprechung/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/materialien/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
