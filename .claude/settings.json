{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "prometheus",
    "LEXMETRIK_NO_ROTATE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm test *)",
      "Bash(npm run golden:vergleich)",
      "Bash(npm run gate)",
      "Bash(npm run gate:schnell)",
      "Bash(npm run check)",
      "Bash(npm run report:inventur)",
      "Bash(npm run check:bibliothek)",
      "Bash(npm run check:verfall)",
      "Bash(npm run check:sweep)",
      "Bash(npm run check:smoke)",
      "Bash(npm run check:caches)",
      "Bash(npm run check:zitate)",
      "Bash(npm run check:fedlex-versionen)",
      "Bash(npm run test:e2e)",
      "Bash(npx --package @ast-grep/cli ast-grep *)",
      "Bash(ast-grep *)",
      "Bash(sg run *)",
      "Bash(npm run map)",
      "Bash(npm run map *)",
      "Bash(npm run ci:log)",
      "Bash(npm run ci:log *)",
      "Bash(npm run test:kurz)",
      "Bash(npm run test:e2e:kurz)",
      "Bash(npx tsc -b)",
      "Bash(npx eslint *)",
      "Bash(curl -s https://www.fedlex.admin.ch/*)",
      "Bash(curl -s https://fedlex.data.admin.ch/*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git pull *)",
      "Bash(git pull)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "mcp__Claude_Preview__preview_screenshot"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/struktur-rotieren.py\" --hook",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/abschluss-wache.py\" --start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-wache.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/abschluss-wache.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tor-schutz.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lese-schutz.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lese-schutz.py\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(start_process|interact_with_process)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tor-schutz.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lese-schutz.py\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(read_file|read_multiple_files)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lese-schutz.py\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(deploy_to_vercel|buy_domain|buy_pro|buy_credits|buy_addon|update_project_deployment_protection)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-schutz.py\""
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-schutz.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-stopp.py\"",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
