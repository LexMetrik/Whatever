    {
      "datum": "2013-07-09",
      "rat": "Nationalrat",
      "ratKuerzel": "NR",
      "text": "Dieses Gesetz wird im Bundesblatt publiziert, wenn der Bundesbeschluss vom 20.06.2013 über die Finanzierung und den Ausbau der Eisenbahninfrastruktur von Volk und Ständen angenommen worden ist.",
      "vorlage": 3
    },
    {
      "datum": "2013-07-09",
      "rat": "Nationalrat",
      "ratKuerzel": "NR",
      "text": "Dieser Beschluss wird gleichzeitig mit dem Bundesgesetz vom 21. Juni 2013 über die Finanzierung und den Ausbau der Eisenbahninfrastruktur im Bundesblatt veröffentlicht.",
      "vorlage": 4
    },
    {
      "datum": "2013-07-09",
      "rat": "Nationalrat",
      "ratKuerzel": "NR",
      "text": "Wird im Bundesblatt veröffentlicht, sobald die entsprechende Rechtsgrundlage in Kraft tritt.",
      "vorlage": 5
    },
    {
      "datum": "2013-08-05",
      "rat": "Nationalrat",
      "ratKuerzel": "NR",
      "text": "Mit Erklärung vom 1. Juli 2013 gibt das Initiativkomitee der Bundeskanzlei davon Kenntnis, dass die Initiative mit der nötigen Mehrheit zurückgezogen worden ist (BBl 2013 6518).",
      "vorlage": 1
    }
