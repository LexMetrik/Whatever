  "srNummer": "0.741.611",
  "titel": "Übereinkommen über den Beförderungsvertrag im internationalen Strassengüterverkehr (CMR)",
  "erlassdatum": "(Stand am 10. Februar 2021)",
  "praeambelTitel": "Präambel",
  "praeambel": [
   {
    "rolle": "autor",
    "text": "Die Vertragsparteien"
   },
   {
    "rolle": "praeambel",
    "text": "in der Erkenntnis, dass es sich empfiehlt, die Bedingungen für den Beförderungsvertrag im internationalen Strassengüterverkehr, insbesondere hinsichtlich der in diesem Verkehr verwendeten Urkunden und der Haftung des Frachtführers, einheitlich zu regeln,"
   },
   {
    "rolle": "verb",
    "text": "haben folgendes vereinbart:"
   }
  ],
