   }
  ],
  "fussnoten": [
   {
    "nr": "1",
    "text": "[BS<b> 1</b> 3]. Den genannten Bestimmungen entsprechen heute die Art. 54, 95 und 101 der BV vom 18. April 1999 (SR <b>101</b>).",
