 "kopf": {
  "srNummer": "0.274.131",
  "titel": "Übereinkommen über die Zustellung gerichtlicher und aussergerichtlicher Schriftstücke im Ausland in Zivil- oder Handelssachen",
  "erlassdatum": "(Stand am 12. Juni 2023)",
  "praeambel": [
   {
    "rolle": "autor",
    "text": "Die Unterzeichnerstaaten dieses Übereinkommens,"
   },
   {
    "rolle": "praeambel",
    "text": "in dem Wunsch, durch geeignete Massnahmen sicherzustellen, dass gerichtliche und aussergerichtliche Schriftstücke, die im Ausland zuzustellen sind, ihren Empfängern rechtzeitig zur Kenntnis gelangen,"
   },
   {
    "rolle": "praeambel",
    "text": "in der Absicht, dafür die gegenseitige Rechtshilfe zu verbessern, indem das Verfahren vereinfacht und beschleunigt wird,"
   },
   {
    "rolle": "verb",
    "text": "haben beschlossen, zu diesem Zweck ein Übereinkommen zu schliessen, und haben die folgenden Bestimmungen vereinbart:"
   }
  ],
  "fussnoten": [
   {
    "nr": "1",
    "text": "Art. 1 Abs. 1 des BB vom 9. Juni 1994 (AS <b>1994</b> 2807)",
    "links": [
     {
      "label": "AS <b>1994</b> 2807",
      "url": "https://fedlex.data.admin.ch/eli/oc/1994/2807_2807_2807"
     }
    ],
    "absatz": null,
    "item": null,
    "kl": "V"
   }
  ]
 },
